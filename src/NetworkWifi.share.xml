  <!-- WiFi settings for products with a WiFi interface (firmware: OFM-Network, OPENKNX_WIFI_AP).
       Only operating mode, setup AP, AP name and AP channel are stored in parameter memory.
       Client credentials and the AP password go online into the device file system (function
       property 160/5) and are never part of the project or readable over the bus. -->
  <!-- Suppress warnings for helper functions that are only called from JS, not from XML -->
  <op:nowarn id="3" regex="NETW_utf8Encode" />
  <op:nowarn id="3" regex="NETW_utf8Decode" />
  <op:nowarn id="3" regex="NETW_call" />
  <op:nowarn id="3" regex="NETW_fillRows" />
  <!-- 2.4 and 5 GHz channel share one byte; the band selects which one is shown -->
  <op:nowarn id="10" regex="Parameter NETW_Channel5?" />
  <!-- 1 = show band selection and 5 GHz channels (hardware with 5 GHz, e.g. ESP32-C5); memory is reserved either way -->
  <op:config name="%Wifi5GHz%" value="0" />
  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>
          <Static>
            <ParameterTypes>
              <ParameterType Id="%AID%_PT-NetwMode" Name="NetwMode">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="Mit vorhandenem WiFi verbinden" Value="0" Id="%ENID%" />
                  <Enumeration Text="Eigenes WiFi (Access Point)" Value="1" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-NetwBand" Name="NetwBand">
                <TypeRestriction Base="Value" SizeInBit="2">
                  <Enumeration Text="2,4 GHz" Value="0" Id="%ENID%" />
                  <Enumeration Text="5 GHz" Value="1" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <!-- 5 GHz without DFS (EU indoor): 36-48 -->
              <ParameterType Id="%AID%_PT-NetwChannel5" Name="NetwChannel5">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="Automatisch" Value="0" Id="%ENID%" />
                  <Enumeration Text="36" Value="36" Id="%ENID%" />
                  <Enumeration Text="40" Value="40" Id="%ENID%" />
                  <Enumeration Text="44" Value="44" Id="%ENID%" />
                  <Enumeration Text="48" Value="48" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-NetwChannel" Name="NetwChannel">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="Automatisch" Value="0" Id="%ENID%" />
                  <Enumeration Text="1" Value="1" Id="%ENID%" />
                  <Enumeration Text="2" Value="2" Id="%ENID%" />
                  <Enumeration Text="3" Value="3" Id="%ENID%" />
                  <Enumeration Text="4" Value="4" Id="%ENID%" />
                  <Enumeration Text="5" Value="5" Id="%ENID%" />
                  <Enumeration Text="6" Value="6" Id="%ENID%" />
                  <Enumeration Text="7" Value="7" Id="%ENID%" />
                  <Enumeration Text="8" Value="8" Id="%ENID%" />
                  <Enumeration Text="9" Value="9" Id="%ENID%" />
                  <Enumeration Text="10" Value="10" Id="%ENID%" />
                  <Enumeration Text="11" Value="11" Id="%ENID%" />
                  <Enumeration Text="12" Value="12" Id="%ENID%" />
                  <Enumeration Text="13" Value="13" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-NetwSsid" Name="NetwSsid">
                <TypeText SizeInBit="256" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-NetwPsk" Name="NetwPsk" ValidationErrorRef="%AID%_M-%TT%00001">
                <!-- empty stays valid: the script clears the field after a transfer; the byte length (UTF-8) is checked by the script -->
                <TypeText SizeInBit="504" Pattern="^$|^.{8,63}$" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-NetwInfo" Name="NetwInfo">
                <TypeText SizeInBit="320" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-NetwSignal" Name="NetwSignal">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="" Value="0" Id="%ENID%" />
                  <Enumeration Text="schwach" Value="1" Id="%ENID%" />
                  <Enumeration Text="mittel" Value="2" Id="%ENID%" />
                  <Enumeration Text="gut" Value="3" Id="%ENID%" />
                  <Enumeration Text="sehr gut" Value="4" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-NetwSecurity" Name="NetwSecurity">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="offen" Value="0" Id="%ENID%" />
                  <Enumeration Text="WEP" Value="1" Id="%ENID%" />
                  <Enumeration Text="WPA" Value="2" Id="%ENID%" />
                  <Enumeration Text="WPA2" Value="3" Id="%ENID%" />
                  <Enumeration Text="WPA/WPA2" Value="4" Id="%ENID%" />
                  <Enumeration Text="WPA3" Value="5" Id="%ENID%" />
                  <Enumeration Text="WPA2/WPA3" Value="6" Id="%ENID%" />
                  <Enumeration Text="Enterprise" Value="7" Id="%ENID%" />
                  <Enumeration Text="unbekannt" Value="255" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-NetwCount" Name="NetwCount">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="8" />
              </ParameterType>
              <!-- Status LEDs: the WiFi state as its own function, merged into the common LED function list -->
              <ParameterType Id="%AID%_PT-SLEDFunc" Name="SLEDFunc">
                <TypeRestriction Base="Value" SizeInBit="16" UIHint="DropDown">
                  <Enumeration Text="WiFi-Status" Value="12" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
